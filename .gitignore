.env
.env.*
!.env.example

__pycache__/
*.pyc
.venv/
venv/

node_modules/

# never commit credentials or auth tokens
credentials.json
token.json
*.key
secrets/

# local runtime state
data/
logs/
*.log

# model weights - too big for git
models/
*.onnx
*.bin
*.gguf

# generated audio - regenerable, large
divyastra/voice/samples/

# wake word training: multi-GB downloads and generated audio
divyastra/voice/training/data/
divyastra/voice/training/output/
divyastra/voice/training/.venv/

# API credentials - never commit
kaggle.json
*.pem
*.p12

# Wake-word training output: ~75MB of synthetic test audio and feature dumps.
# The trained model itself is copied into voice/models/ and committed there.
divyastra/voice/training/output/
divyastra/voice/training/.venv/

# ...but our own wake-word model is small (161 KB) and is the build output of a
# GPU training run we do not want to repeat. Keep it, and its evidence.
!divyastra/voice/models/hey_divya.onnx
!divyastra/voice/models/hey_divya_eval.json
!divyastra/voice/models/hey_divya_det.png
